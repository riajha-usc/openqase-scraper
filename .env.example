# Copy to .env.local (git-ignored).

# # --- Option A: Anthropic (default) ---
# OQ_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OQ_MODEL=claude-opus-5-5

# --- Option B: any OpenAI-compatible endpoint (free tiers: Gemini, Groq; local: Ollama) ---
# OQ_PROVIDER=openai_compatible
# Gemini:  OQ_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   OQ_MODEL=gemini-2.5-flash
# Groq:    OQ_BASE_URL=https://api.groq.com/openai/v1                              OQ_MODEL=llama-3.3-70b-versatile
# Ollama:  OQ_BASE_URL=http://localhost:11434/v1                                   OQ_MODEL=llama3.1   (OQ_API_KEY can be anything)
# OQ_BASE_URL=
# OQ_API_KEY=
# OQ_MODEL=

OQ_PROVIDER=openai_compatible
OQ_API_KEY=
OQ_MODEL=openai/gpt-oss-120b

# Optional: override the SQLite path (default: data/candidates.db)
# OQ_DB=
